Cell[BoxData[{
 RowBox[{"Print", 
  "[", "\"\<We now define a new variable p = b+y. In the new variables \
(a,b,p,e), the above dynamical system becomes:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{"aprime", ",", "bprime", ",", "yprime", ",", "eprime"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<aprime:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"aprime", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "1"}], "/", "b"}], " ", "*", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"8", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "^", "2"}], " ", "-", 
         RowBox[{"p", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}]}], " ", "+", " ", 
     RowBox[{"16", " ", 
      RowBox[{"a", "^", "2"}], " ", 
      RowBox[{"e", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "e"}], ")"}], "^", "2"}]}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<bprime:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"bprime", " ", "=", " ", 
  RowBox[{
   RowBox[{"16", 
    RowBox[{"(", 
     RowBox[{"p", "-", "b"}], ")"}]}], "+", " ", 
   RowBox[{"8", "p", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", "-", "b"}], ")"}], "/", "a"}]}], " ", "+", " ", 
   RowBox[{"4", "b", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", "2"}], " ", "-", " ", 
       RowBox[{"p", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"a", " ", "b", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<pprime:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"pprime", "=", " ", 
  RowBox[{
   RowBox[{"16", "p", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"p", "-", "b"}], ")"}], "/", "a"}]}], " ", "+", " ", 
   RowBox[{"4", "p", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", "2"}], " ", "-", " ", 
       RowBox[{"p", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"a", " ", "b", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}], ")"}]}]}]}]}], "\[IndentingNewLine]", 

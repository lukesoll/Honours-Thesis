Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Print", "[", "\"\<The derivative of this is given by:\>\"", "]"}],
    "\[IndentingNewLine]", 
   RowBox[{"Vprime", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"aprime", "/", "b"}], " ", "-", " ", 
           RowBox[{"a", " ", 
            RowBox[{"bprime", "/", 
             RowBox[{"b", "^", "2"}]}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", "e"}], ")"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "/", "b"}], ")"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "eprime"}], ")"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "e"}], ")"}], "^", "2"}]}]}]}], " ", ")"}], "+",
       " ", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"pprime", "/", "b"}], " ", "-", " ", 
         RowBox[{"p", " ", 
          RowBox[{"bprime", "/", 
           RowBox[{"b", "^", "2"}]}]}]}], ")"}]}], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "p", " ", 
         RowBox[{"pprime", "/", 
          RowBox[{"(", 
           RowBox[{"a", " ", "b"}], ")"}]}]}], "-", " ", 
        RowBox[{
         RowBox[{"p", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a", " ", "bprime"}], " ", "+", " ", 
            RowBox[{"aprime", " ", "b"}]}], ")"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", " ", "b"}], ")"}], "^", "2"}]}]}]}], ")"}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.999579332397972*^9, 3.9995793789263535`*^9}, {
  3.9995795388697224`*^9, 3.9995795410032864`*^9}},

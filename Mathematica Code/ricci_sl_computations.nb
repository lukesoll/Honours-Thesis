  RowBox[{"16", "+", 
   RowBox[{"8", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "+", "y"}], ")"}], "/", "a"}]}], " ", "+", " ", 
   RowBox[{"4", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", "2"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "+", "y"}], ")"}], "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"a", " ", "y", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ydotnewnew", " ", "=", " ", 
   RowBox[{

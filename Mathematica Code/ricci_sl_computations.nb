Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<We now turn to constructing a Lyapunov function. This \
is achieved by the following quantity. Notice this is just a slight \
modification of the decay rate of e\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"V", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "/", "b"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", "e"}], ")"}]}], " ", "+", " ", 
     RowBox[{"2", 
      RowBox[{"p", "/", "b"}]}], "-", "4", " ", "+", " ", 
     RowBox[{
      RowBox[{"p", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"a", " ", "b"}], ")"}]}]}]}]}]}]], "Input",

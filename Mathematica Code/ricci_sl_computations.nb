   4.0047503847046604`*^9},
 CellLabel->
  "Out[413]=",ExpressionUUID->"0a6e4075-1232-6446-b5f6-22879a58c38c"],

Cell[BoxData["\<\"However, notice that P is manifestly nonnegative since it \
is a sum of nonnegative terms, and moreover is minimised precisely when \
claimed.\"\>"], "Print",
 CellChangeTimes->{{4.0047502303812466`*^9, 4.0047502353572063`*^9}, 
   4.0047502655479546`*^9, 4.004750384720745*^9},

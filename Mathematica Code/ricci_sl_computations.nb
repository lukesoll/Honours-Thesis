Cell[BoxData["\<\"We now turn to constructing a Lyapunov function. This is \
achieved by the following quantity. Notice this is just a slight modification \
of the decay rate of e\"\>"], "Print",
 CellChangeTimes->{
  3.999579330355875*^9, {3.9996234321717796`*^9, 3.999623461753292*^9}, 

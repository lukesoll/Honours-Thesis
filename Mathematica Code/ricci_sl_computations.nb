Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", 
  "[", "\"\<We can finally verify the appropriate non-negativity \
conditions:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<We start by verifying that the normalised part of V' is \
nonnegative:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Vprimenormal", ">=", "0"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", ">", "0"}], "&&", 
      RowBox[{"b", ">", "0"}], " ", "&&", " ", 
      RowBox[{"p", ">=", "b"}], " ", "&&", " ", 
      RowBox[{"0", "<=", "e", "<", "1"}]}], ")"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<We then verify that when e > 0, we cannot attain equality (here, \
false means no solutions exist when e>0, which is what is needed):\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Vprimenormal", "==", "0"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", ">", "0"}], "&&", 
      RowBox[{"b", ">", "0"}], " ", "&&", " ", 
      RowBox[{"p", ">=", "b"}], " ", "&&", " ", 
      RowBox[{"0", "<", "e", "<", "1"}]}], ")"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Likewise, under the new condition e=0, we verify that when p>b, \
we cannot attain equality (here, false means no solutions exist when e=0 and \
p>b, which is what is needed):\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Vprimenormal", "==", "0"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", ">", "0"}], "&&", 
      RowBox[{"b", ">", "0"}], " ", "&&", " ", 
      RowBox[{"p", ">", "b"}], " ", "&&", " ", 
      RowBox[{"e", "==", "0"}]}], ")"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Finally, under the conditions of e=0 and p=b, we find that \
equality occurs precisely when p=a:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Vprimenormal", "==", "0"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", ">", "0"}], "&&", 
      RowBox[{"b", ">", "0"}], " ", "&&", " ", 
      RowBox[{"p", "==", "b"}], " ", "&&", " ", 
      RowBox[{"e", "==", "0"}]}], ")"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9995797877268486`*^9, 3.999579822625305*^9}, {
  3.9995798700463753`*^9, 3.9995799060888405`*^9}},
 CellLabel->
  "In[338]:=",ExpressionUUID->"b54f546f-2f83-aa40-9e9a-bc4a365d38c7"],


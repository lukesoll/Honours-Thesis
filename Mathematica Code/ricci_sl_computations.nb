Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", 
  "[", "\"\<We now compute the equation for edot. This can be computed as \
follows. The first line is a pure definition, the second a simplification in \
terms of e, and the last a check that they agree (and hence should be \
zero).\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"edot", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"2", "v", " ", 
     RowBox[{"vdot", "/", " ", 
      RowBox[{"(", 
       RowBox[{"b", " ", "y"}], ")"}]}]}], "-", 
    RowBox[{
     RowBox[{"v", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"b", " ", "ydot"}], " ", "+", " ", 
        RowBox[{"bdot", " ", "y"}]}], ")"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b", " ", "y"}], ")"}], "^", "2"}]}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"edotnew", "=", 
  RowBox[{"8", 
   RowBox[{"e", "/", 
    RowBox[{"(", 
     RowBox[{"b", " ", "y"}], ")"}]}], " ", "*", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{"b", "-", "y"}], ")"}]}], " ", "-", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b", "+", "y"}], ")"}], "^", "2"}], "/", "a"}], " ", "-", " ", 
     RowBox[{"2", 
      RowBox[{"a", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e", "=", 
   RowBox[{
    RowBox[{"v", "^", "2"}], " ", "/", 
    RowBox[{"(", 
     RowBox[{"b", " ", "y"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"edot", "-", "edotnew"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "e", "]"}]}], "Input",
 CellChangeTimes->{{3.9991028888112736`*^9, 3.9991028905895157`*^9}, {
  3.9991036382393036`*^9, 3.999103640168049*^9}, {3.999105028781412*^9, 

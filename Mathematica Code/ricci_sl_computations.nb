        RowBox[{"-", "1"}], "+", "e"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"b", "+", 
        RowBox[{"b", " ", "e"}], "-", "p"}], ")"}]}], "-", 
     RowBox[{"8", " ", "a", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "e"}], ")"}], "3"], " ", 

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "4"}], "+", 
  FractionBox["a", 
   RowBox[{"b", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "e"}], ")"}]}]], "+", 
  FractionBox[
   RowBox[{"2", " ", "p"}], "b"], "+", 
  FractionBox[
   SuperscriptBox["p", "2"], 
   RowBox[{"a", " ", "b"}]]}]], "Output",

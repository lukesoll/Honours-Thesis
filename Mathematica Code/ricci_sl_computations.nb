Cell[BoxData["\<\"We now compute the equation for edot. This can be computed \
as follows. The first line is a pure definition, the second a simplification \
in terms of e, and the last a check that they agree (and hence should be \
zero).\"\>"], "Print",
 CellChangeTimes->{{3.9995789136386795`*^9, 3.999578930077265*^9}, 

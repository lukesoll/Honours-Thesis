Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9995798311716537`*^9, 3.999579906620844*^9, 
  3.999623536795868*^9, 3.9996502015528965`*^9, 3.9996706876751175`*^9, 
  3.999708091531351*^9, 4.0047499709286823`*^9},
 CellLabel->
  "Out[340]=",ExpressionUUID->"571c44eb-1b62-864b-aedc-e4a70db52672"],

Cell[BoxData["\<\"We then verify that when e > 0, we cannot attain equality \
(here, false means no solutions exist when e>0, which is what is \
needed):\"\>"], "Print",
 CellChangeTimes->{3.9995798232611465`*^9, 3.9995799066158466`*^9, 
  3.9996235274822197`*^9, 3.9996501929718685`*^9, 3.9996706793109207`*^9, 
  3.999708081776123*^9, 4.0047499709343033`*^9},
 CellLabel->
  "During evaluation of \
In[338]:=",ExpressionUUID->"41036bc5-0c78-624a-b006-dc22f65e5db8"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.9995798311716537`*^9, 3.999579906620844*^9, 
  3.999623536795868*^9, 3.9996502015528965`*^9, 3.9996706876751175`*^9, 
  3.999708091531351*^9, 4.004750017996063*^9},
 CellLabel->
  "Out[342]=",ExpressionUUID->"e4c6d895-0368-3646-b526-3237bccae213"],

Cell[BoxData["\<\"Likewise, under the new condition e=0, we verify that when \
p>b, we cannot attain equality (here, false means no solutions exist when e=0 \
and p>b, which is what is needed):\"\>"], "Print",
 CellChangeTimes->{3.9995798232611465`*^9, 3.9995799066158466`*^9, 
  3.9996235274822197`*^9, 3.9996501929718685`*^9, 3.9996706793109207`*^9, 
  3.999708081776123*^9, 4.004750018005619*^9},
 CellLabel->
  "During evaluation of \
In[338]:=",ExpressionUUID->"b6c92e5c-3901-f84a-8af8-0123c8deee31"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.9995798311716537`*^9, 3.999579906620844*^9, 
  3.999623536795868*^9, 3.9996502015528965`*^9, 3.9996706876751175`*^9, 
  3.999708091531351*^9, 4.00475001827479*^9},
 CellLabel->
  "Out[344]=",ExpressionUUID->"fd69a9a7-f922-fb42-920e-fa09176e06fc"],

Cell[BoxData["\<\"Finally, under the conditions of e=0 and p=b, we find that \
equality occurs precisely when p=a:\"\>"], "Print",
 CellChangeTimes->{3.9995798232611465`*^9, 3.9995799066158466`*^9, 
  3.9996235274822197`*^9, 3.9996501929718685`*^9, 3.9996706793109207`*^9, 
  3.999708081776123*^9, 4.004750018292383*^9},
 CellLabel->
  "During evaluation of \
In[338]:=",ExpressionUUID->"9ca9cdb1-1a99-7d44-af82-a306635969a3"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["a", "2"], "\[Equal]", 
  SuperscriptBox["p", "2"]}]], "Output",
 CellChangeTimes->{3.9995798311716537`*^9, 3.999579906620844*^9, 
  3.999623536795868*^9, 3.9996502015528965`*^9, 3.9996706876751175`*^9, 
  3.999708091531351*^9, 4.00475001842428*^9},
 CellLabel->
  "Out[346]=",ExpressionUUID->"cffd1039-4d49-a241-b06b-41f485faa125"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", 
  "[", "\"\<We now want an explicit verification that Vprime has the claimed \
sign. To do this, we define the following quantity P. Here, t = 1-e and q = \
p-b.\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"P", "=", 
  RowBox[{
   RowBox[{"3", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", "2"}], "-", 
       RowBox[{"t", " ", "b", " ", "p"}]}], ")"}], "^", "2"}]}], " ", "+", 
   " ", 
   RowBox[{"3", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", " ", "p", " ", "q"}], " ", "-", " ", 
       RowBox[{"e", " ", 
        RowBox[{"a", "^", "2"}]}]}], ")"}], "^", "2"}]}], " ", "+", " ", 
   RowBox[{"e", " ", 
    RowBox[{"a", "^", "2"}], " ", 
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "e"}], ")"}], 
       RowBox[{"a", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"t", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "a"}], "-", "b"}], ")"}], "^", "2"}]}]}], ")"}]}], " ",
    "+", " ", 
   RowBox[{"t", " ", "q", " ", 
    RowBox[{"a", "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", "a"}], " ", "+", " ", 
      RowBox[{"p", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", "e"}], "-", "2"}], ")"}], "^", "2"}]}], "+", 
      RowBox[{"e", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"t", " ", "p"}], " ", "+", " ", "b"}], ")"}]}]}], ")"}]}], 
   " ", "+", " ", 
   RowBox[{"2", 
    RowBox[{"t", "^", "3"}], " ", "p", " ", 
    RowBox[{"q", "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"p", "+", 
      RowBox[{"4", "a"}]}], ")"}]}], "+", 
   RowBox[{"6", "e", " ", 
    RowBox[{"t", "^", "2"}], " ", "b", " ", 
    RowBox[{"p", "^", "2"}], " ", "q"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{"1", "-", "e"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{"p", "-", "b"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<We can check that up to a negative scaling factor, Vprime and P \
are in fact equal:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"Vprime", "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "4"}], 
     RowBox[{"P", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", "^", "2"}], " ", 
        RowBox[{"b", "^", "2"}], " ", 
        RowBox[{"t", "^", "3"}]}], ")"}]}]}], ")"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{"t", ",", "q"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<However, notice that P is manifestly nonnegative since it is a \
sum of nonnegative terms, and moreover is minimised precisely when claimed.\>\
\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9997228528001766`*^9, 3.9997231140289116`*^9}, {
  3.999723190602663*^9, 3.999723213628626*^9}, {4.004750106950594*^9, 
  4.004750323739418*^9}, {4.004750377667057*^9, 4.0047503842431526`*^9}},
 CellLabel->
  "In[408]:=",ExpressionUUID->"2184bbd9-f46e-b54b-8b01-1e359c93573d"],

Cell[BoxData["\<\"We now want an explicit verification that Vprime has the \
claimed sign. To do this, we define the following quantity P. Here, t = 1-e \
and q = p-b.\"\>"], "Print",
 CellChangeTimes->{{4.0047502303812466`*^9, 4.0047502353572063`*^9}, 
   4.0047502655479546`*^9, 4.0047503846886616`*^9},
 CellLabel->
  "During evaluation of \
In[408]:=",ExpressionUUID->"a9e9306e-b468-5a4a-9119-9fe92cc21f2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"6", " ", "b", " ", "e", " ", 
   SuperscriptBox["p", "2"], " ", "q", " ", 
   SuperscriptBox["t", "2"]}], "+", 
  RowBox[{"2", " ", "p", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", " ", "a"}], "+", "p"}], ")"}], " ", 
   SuperscriptBox["q", "2"], " ", 
   SuperscriptBox["t", "3"]}], "+", 
  RowBox[{
   SuperscriptBox["a", "2"], " ", "e", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "e"}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "a"}], "-", "b"}], ")"}], "2"], " ", "t"}]}], 
    ")"}]}], "+", 
  RowBox[{"3", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["a", "2"], "-", 
      RowBox[{"b", " ", "p", " ", "t"}]}], ")"}], "2"]}], "+", 
  RowBox[{"3", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["a", "2"]}], " ", "e"}], "+", 
      RowBox[{"p", " ", "q", " ", "t"}]}], ")"}], "2"]}], "+", 
  RowBox[{
   SuperscriptBox["a", "2"], " ", "q", " ", "t", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", " ", "a"}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "+", 
         RowBox[{"3", " ", "e"}]}], ")"}], "2"], " ", "p"}], "+", 
     RowBox[{"e", " ", 
      RowBox[{"(", 
       RowBox[{"b", "+", 
        RowBox[{"p", " ", "t"}]}], ")"}]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{{3.999722855878477*^9, 3.999722927583521*^9}, {
   3.999723107956873*^9, 3.999723110382433*^9}, {3.999723188447956*^9, 
   3.9997232144074078`*^9}, 4.0047500639898624`*^9, 4.0047501373611546`*^9, {
   4.004750230383766*^9, 4.0047502353745213`*^9}, 4.004750265566925*^9, 
   4.0047503847046604`*^9},
 CellLabel->
  "Out[409]=",ExpressionUUID->"e84d8125-9abb-4046-ba13-5af2508b6f0c"],

Cell[BoxData["\<\"We can check that up to a negative scaling factor, Vprime \
and P are in fact equal:\"\>"], "Print",
 CellChangeTimes->{{4.0047502303812466`*^9, 4.0047502353572063`*^9}, 
   4.0047502655479546`*^9, 4.0047503847046604`*^9},
 CellLabel->

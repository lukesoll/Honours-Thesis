        RowBox[{"b", "-", "p"}], ")"}], "2"], " ", "p"}], "+", 
     RowBox[{
      SuperscriptBox["a", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "e"}], ")"}], " ", "p", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "b", " ", 
         RowBox[{"(", 
          RowBox[{"5", "-", 
           RowBox[{"9", " ", "e"}], "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["e", "2"]}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "4"}], "+", 
           RowBox[{"17", " ", "e"}], "-", 
           RowBox[{"8", " ", 
            SuperscriptBox["e", "2"]}]}], ")"}], " ", "p"}]}], ")"}]}], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "e"}], ")"}], "2"], " ", 
      SuperscriptBox["p", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"8", " ", 
         SuperscriptBox["b", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "e"}], ")"}]}], "-", 

Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", "e", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", "a"}], 
       RowBox[{"1", "-", "e"}]]}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"b", "-", "y"}], ")"}]}], "-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"b", "+", "y"}], ")"}], "2"], "a"]}], ")"}]}], 

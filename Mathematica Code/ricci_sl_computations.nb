         RowBox[{"a", "^", "2"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "+", "y"}], ")"}], "^", "2"}]}], " ", ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}]}]}], ")"}]}]}], "\[IndentingNewLine]", 

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<Since we only care about the non-positivity of V, and \
also precisely when it is minimised, it suffices to consider the following \
'normalised' expression, for which we need non-negativity (plus the \
appropriate conditions on vanishing). This quantity can be realised as a \
quartic in a, with the terms following being the coefficients of this \
polynomial.\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Vprimenormal", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Vprime", "*", 
      RowBox[{"a", "^", "2"}], " ", 
      RowBox[{"b", "^", "2"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"e", "-", "1"}], ")"}], "^", "3"}], " ", "/", "4"}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.999579401383383*^9, 3.9995795293938923`*^9}, {
   3.999579560366806*^9, 3.999579605548626*^9}, 3.999708063765972*^9, {
   4.0047499502583923`*^9, 4.0047499512773857`*^9}},
 CellLabel->
  "In[336]:=",ExpressionUUID->"b9a09f3f-29df-a646-953e-d9badbdb30c6"],

Cell[BoxData["\<\"Since we only care about the non-positivity of V, and also \
precisely when it is minimised, it suffices to consider the following \
'normalised' expression, for which we need non-negativity (plus the \
appropriate conditions on vanishing). This quantity can be realised as a \
quartic in a, with the terms following being the coefficients of this \
polynomial.\"\>"], "Print",
 CellChangeTimes->{{3.9995795298577347`*^9, 3.9995795434205513`*^9}, 
   3.9995796058945103`*^9, 3.9996235162283*^9, 3.9996501873038235`*^9, 
   3.999708068955597*^9, 4.004749952346237*^9},
 CellLabel->

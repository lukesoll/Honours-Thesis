Cell[BoxData[
 FractionBox[
  RowBox[{"8", " ", 
   SuperscriptBox["v", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"b", "-", "y"}], ")"}]}], "-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"b", "+", "y"}], ")"}], "2"], "a"], "+", 
     FractionBox[
      RowBox[{"2", " ", "a", " ", "b", " ", "y"}], 
      RowBox[{
       SuperscriptBox["v", "2"], "-", 
       RowBox[{"b", " ", "y"}]}]]}], ")"}]}], 
  RowBox[{
   SuperscriptBox["b", "2"], " ", 
   SuperscriptBox["y", "2"]}]]], "Output",
 CellChangeTimes->{{3.999105601703068*^9, 3.999105608367895*^9}, {

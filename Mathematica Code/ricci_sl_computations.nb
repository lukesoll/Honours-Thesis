Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", 
  "[", "\"\<We can multiply all equations by y, which has the effect of \
'slowing time' (we are traversing the integral curves more slowly). We denote \
the derivatives by primes in this new system. The follow is the corresponding \
dynamical system upon doing this process:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<aprime:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"aprime", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "1"}], "/", "b"}], " ", "*", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"8", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "^", "2"}], " ", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "+", "y"}], ")"}], "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}]}], " ", "+", " ", 
     RowBox[{"16", " ", 
      RowBox[{"a", "^", "2"}], " ", 
      RowBox[{"e", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "e"}], ")"}], "^", "2"}]}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<bprime:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"bprime", " ", "=", " ", 
  RowBox[{
   RowBox[{"16", "y"}], " ", "+", " ", 
   RowBox[{"8", 
    RowBox[{"(", 
     RowBox[{"b", "+", "y"}], ")"}], 
    RowBox[{"y", "/", "a"}]}], " ", "+", " ", 
   RowBox[{"4", "b", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", "2"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "+", "y"}], ")"}], "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"a", " ", "b", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<yprime:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"yprime", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "16"}], "y"}], "+", " ", 
   RowBox[{"8", 
    RowBox[{"(", 
     RowBox[{"b", "+", "y"}], ")"}], 
    RowBox[{"y", "/", "a"}]}], " ", "+", " ", 
   RowBox[{"4", "y", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", "2"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "+", "y"}], ")"}], "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"a", " ", "b", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "e"}], ")"}]}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<eprime:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eprime", "=", 
   RowBox[{
    RowBox[{"-", "8"}], " ", 
    RowBox[{"e", "/", "b"}], " ", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"a", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "e"}], ")"}]}]}], " ", "-", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"b", "-", "y"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "+", "y"}], ")"}], "^", "2"}], "/", "a"}]}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<we now verify that these agree with the original equations (all \
the expressions should be zero):\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e", "=", 
   RowBox[{
    RowBox[{"v", "^", "2"}], " ", "/", 
    RowBox[{"(", 
     RowBox[{"b", " ", "y"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"aprime", "/", "y"}], " ", "-", " ", "adot"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"bprime", "/", "y"}], " ", "-", " ", "bdot"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"yprime", "/", "y"}], " ", "-", " ", "ydot"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"eprime", "/", "y"}], " ", "-", " ", "edot"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "e", "]"}]}], "Input",
 CellChangeTimes->{

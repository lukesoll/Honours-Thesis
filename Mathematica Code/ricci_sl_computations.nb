In[336]:=",ExpressionUUID->"5ffa4c36-a0de-fc47-bfad-d354742d960d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["a", "4"], " ", 
   RowBox[{"(", 
    RowBox[{"3", "+", 
     RowBox[{"5", " ", "e"}]}], ")"}]}], "+", 
  RowBox[{"4", " ", 
   SuperscriptBox["a", "3"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "e"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"b", "+", 
     RowBox[{"b", " ", "e"}], "-", "p"}], ")"}]}], "-", 
  RowBox[{"8", " ", "a", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "e"}], ")"}], "3"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"b", "-", "p"}], ")"}], "2"], " ", "p"}], "+", 
  RowBox[{
   SuperscriptBox["a", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "e"}], ")"}], " ", "p", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", "b", " ", 
      RowBox[{"(", 
       RowBox[{"5", "-", 
        RowBox[{"9", " ", "e"}], "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["e", "2"]}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "4"}], "+", 
        RowBox[{"17", " ", "e"}], "-", 
        RowBox[{"8", " ", 
         SuperscriptBox["e", "2"]}]}], ")"}], " ", "p"}]}], ")"}]}], "-", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "e"}], ")"}], "2"], " ", 
   SuperscriptBox["p", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"8", " ", 
      SuperscriptBox["b", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "e"}], ")"}]}], "-", 
     RowBox[{"10", " ", "b", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "e"}], ")"}], " ", "p"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
